# ---------------------------------------------------------------------------
# Railway production image for RetinaVision AI
# Full-stack: Vite frontend + Express backend + ONNX EfficientNet-B0 inference.
#
# Build & run (Railway uses this automatically):
#   docker build -f Dockerfile.railway -t retinavision-ai .
#   docker run --rm -e PORT=3000 -e DATABASE_URL="..." -p 3000:3000 retinavision-ai
#
# Model files are baked into the image under /opt/retinavision/models and
# served from there at runtime via ML_MODEL_BASE_URL=file:///opt/retinavision/models
# (no external storage dependency). If you prefer hosting the models on your own
# CDN/bucket instead, set ML_MODEL_BASE_URL=https://your-cdn.example.com/models
# and remove the two "models" COPY lines below.
# ---------------------------------------------------------------------------

FROM node:22-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Models (EfficientNet-B0 ONNX, ~16 MB each) — bundled into the image.
COPY ml-backend/best_model_inline.onnx          /opt/retinavision/models/best_model_inline_59ab4bc7.onnx
COPY ml-backend/best_model_features_inline.onnx /opt/retinavision/models/best_model_features_inline_a1c9cf30.onnx

COPY package.json pnpm-lock.yaml ./
COPY patches ./patches
RUN npm install -g corepack@latest \
    && corepack enable \
    && corepack pnpm install --prod=false \
    && rm -rf ~/.npm ~/.local/share/pnpm/store/v3/*/tmp

COPY . .
RUN corepack pnpm run build

ENV NODE_ENV=production \
    ML_MODEL_BASE_URL=file:///opt/retinavision/models

EXPOSE 3000

CMD ["node", "dist/index.js"]
